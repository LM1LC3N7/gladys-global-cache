{
  "name": "gladys-global-cache",
  "version": "0.1.1",
  "private": true,
  "description": "Gladys Assistant external integration for Global Caché iTach, Flex and GC-100 gateways (IR codes from scenes, relays, sensor inputs), over their local Unified TCP API. Unofficial, not affiliated with Global Caché.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "license": "Apache-2.0"
}
